{
  "name": "bar-da-ladeira-impressao-electron",
  "version": "1.0.0",
  "description": "Aplicativo desktop de impressao em tempo real do Bar da Ladeira",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "Bar da Ladeira",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "verificar": "tsc --noEmit && vite build --mode producao",
    "limpar:release": "rm -rf release",
    "empacotar": "npm run build && electron-builder --win --x64 --publish never",
    "empacotar:win": "npm run build && electron-builder --win --x64 --publish never",
    "test": "node --test tests/*.test.mjs",
    "empacotar:mac": "npm run build && electron-builder --mac --arm64 --publish never",
    "empacotar:tudo": "npm run build && electron-builder --win --x64 --publish never && electron-builder --mac --arm64 --publish never",
    "empacotar:mac:dmg": "npm run build && electron-builder --mac dmg --arm64 --publish never"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.49.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^10.1.0",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.bardaladeira.impressao",
    "productName": "Bar da Ladeira Impressao",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "icon": "public/icon.ico",
      "artifactName": "${productName}-${version}-win-x64.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Bar da Ladeira Impressao",
      "artifactName": "${productName}-${version}-win-x64-instalador.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.business",
      "artifactName": "${productName}-${version}-mac-arm64.${ext}",
      "darkModeSupport": true,
      "identity": "-",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac-arm64.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-x64-portatil.${ext}"
    }
  }
}
